{
  "name": "spark-lan",
  "version": "0.4.1",
  "description": "Spark — локальные чаты, звонки и файлы",
  "private": true,
  "author": "EugeneHeisst",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "desktopName": "dev.eugeneheisst.spark.desktop",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "node scripts/build.mjs && electron .",
    "test:e2e": "playwright test",
    "test:e2e:linux": "node scripts/test-linux.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "package:win": "electron-builder --win nsis zip --x64",
    "test:updates": "node --test tests/update/*.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.eugeneheisst.spark",
    "productName": "Spark",
    "copyright": "Copyright © 2026 EugeneHeisst",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/*.cjs",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "desktop/binaries",
        "to": "bin",
        "filter": [
          "spark-service",
          "spark-service.exe"
        ]
      },
      {
        "from": "assets",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "syncDesktopName": true,
      "category": "Network;InstantMessaging;",
      "icon": "assets/icon.png",
      "artifactName": "Spark-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Spark",
          "Comment": "Чаты и звонки в локальной сети"
        }
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "Spark-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Spark",
      "artifactName": "Spark-${version}-windows-setup.exe"
    },
    "publish": null
  },
  "dependencies": {
    "@electron/asar": "4.3.1",
    "tar-stream": "3.2.2",
    "yauzl": "3.4.0"
  }
}
