{
  "name": "spark-lan",
  "version": "0.1.0",
  "description": "Spark — локальные чаты, звонки и файлы",
  "private": true,
  "author": "EugeneHeisst",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "node scripts/build.mjs && electron .",
    "test:e2e": "playwright test",
    "package:linux": "electron-builder --linux AppImage tar.gz --x64",
    "package:win": "electron-builder --win nsis zip --x64"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.eugeneheisst.spark",
    "productName": "Spark",
    "copyright": "Copyright © 2026 EugeneHeisst",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["desktop/main.cjs", "desktop/preload.cjs", "package.json"],
    "extraResources": [
      { "from": "desktop/binaries", "to": "bin", "filter": ["spark-service", "spark-service.exe"] },
      { "from": "assets", "to": "ui", "filter": ["**/*"] }
    ],
    "linux": {
      "category": "Network;InstantMessaging;",
      "icon": "assets/icon.png",
      "artifactName": "Spark-${version}-linux-${arch}.${ext}",
      "desktop": { "entry": { "Name": "Spark", "Comment": "Чаты и звонки в локальной сети" } }
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "Spark-${version}-windows-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Spark",
      "artifactName": "Spark-${version}-windows-setup.exe"
    },
    "publish": null
  }
}
